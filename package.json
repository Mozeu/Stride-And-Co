{
  "name": "stride-co",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "supervisor ./bin/www",
    "seed": "node scripts/seed.js",
    "setup:local": "node scripts/setup-local.js",
    "setup:test": "node scripts/setup-test.js",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "accesscontrol": "^3.1.1",
    "bcrypt": "^6.0.0",
    "config": "^4.4.2",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "^4.22.3",
    "express-jwt": "^8.5.1",
    "http-errors": "~1.6.3",
    "i18n": "^0.15.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pug": "^2.0.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "supervisor": "^0.12.0"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true
  }
}
