extends layout
include mixins/product-card

block content
  main.container.py-5
    h1.fw-bold.mb-4#productos= __('store.products')
    if products && products.length
      .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
        each product in products
          .col
            +productCard(product)
    else
      - const emptyMessage = __('products.Empty')
      include partials/empty-state
