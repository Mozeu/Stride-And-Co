extends ../../layout
include ../../mixins/form-field

block content
  main.container.py-5
    section.store-panel.admin-data-panel.p-3.p-md-4
      a.small.text-secondary.d-inline-block.mb-3(href='/admin/products')
        i.bi.bi-arrow-left.me-1(aria-hidden='true')
        = __('admin.products.back')
      h1.h3.fw-bold.mb-4= product ? __('admin.products.editTitle') : __('admin.products.newTitle')

      form(method='post', action=action, novalidate)
        +formField('name', __('admin.products.fields.name'), values.name, 'text', errors.name, true)
        +formField('brand', __('admin.products.fields.brand'), values.brand, 'text', errors.brand, false)

        .mb-3
          label.form-label(for='description')= __('admin.products.fields.description')
          textarea.form-control(
            id='description'
            name='description'
            rows='4'
            class=errors.description ? 'is-invalid' : null
            aria-describedby=errors.description ? 'description-error' : null
          )= values.description
          if errors.description
            .invalid-feedback(id='description-error')= errors.description

        +formField('price', __('admin.products.fields.price'), values.price, 'text', errors.price, true)

        .mb-3
          label.form-label(for='category_id')= __('admin.products.fields.category')
          select.form-select(
            id='category_id'
            name='category_id'
            class=errors.category ? 'is-invalid' : null
            aria-describedby=errors.category ? 'category_id-error' : null
          )
            option(value='')= __('admin.products.noCategory')
            each category in categories
              option(value=category.id, selected=String(values.category_id) === String(category.id))= category.label
          if errors.category
            .invalid-feedback(id='category_id-error')= errors.category

        .form-check.form-switch.mb-4
          input.form-check-input(type='checkbox', id='active', name='active', checked=values.active)
          label.form-check-label(for='active')= __('admin.products.fields.active')

        .d-flex.gap-2
          button.btn.btn-dark(type='submit')= product ? __('admin.products.save') : __('admin.products.createButton')
          a.btn.btn-outline-dark(href='/admin/products')= __('admin.products.cancel')
