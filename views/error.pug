extends layout

block content
  main.container.error-page
    section.error-card(role='alert')
      p.error-code= status
      h1= message
      p= __('webErrors.genericMessage')
      a.btn.btn-dark.error-home(href='/')= __('webErrors.home')
      if error && error.stack
        details.error-details
          summary= __('webErrors.details')
          pre= error.stack
