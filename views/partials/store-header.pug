header.store-header
  .container.py-2.d-flex.justify-content-between.align-items-center.gap-3
    a.brand(href='/')
      | STRIDE
      span= ' & CO'
      small.d-block.fw-normal.text-secondary MOVE YOUR WAY
    nav.store-nav.d-flex.align-items-center(aria-label=__('store.navigation'))
      a.nav-link(href='/')= __('store.home')
      a.nav-link(href='/products')= __('store.products')
    .d-flex.flex-wrap.align-items-center.gap-2
      a.btn.btn-outline-dark.btn-sm(href='/cart', aria-label=__('store.cart.title'), title=__('store.cart.title'))
        i.bi.bi-bag(aria-hidden='true')
      if user
        if user.role && user.role.permissions && user.role.permissions.some(permission => permission.key === 'orders:read:own')
          a.btn.btn-outline-dark.btn-sm(href='/my/orders')= __('store.orders.title')
        if can && can('products', 'read', 'any') && can('orders', 'read', 'any')
          a.btn.btn-outline-dark.btn-sm(href='/admin')= __('admin.navigation')
        if can && can('products', 'read', 'any') && can('products', 'update', 'any')
          a.btn.btn-outline-dark.btn-sm(href='/admin/products')= __('admin.products.shortTitle')
        form(method='post', action='/logout')
          button.btn.btn-outline-dark.btn-sm(type='submit')= __('store.logout')
        - const accountSymbol = can && can('users', 'delete', 'any') ? '★' : can && can('orders', 'update', 'any') ? '◆' : '●'
        span.account-user.small.text-secondary(title=user.role && user.role.name ? user.role.name : 'user')
          span.account-symbol.me-1(aria-hidden='true')= accountSymbol
          = user.first_name
      else
        a.btn.btn-dark.btn-sm(href='/login')= __('store.login')
      if languageLinks
        .d-flex
          each link in languageLinks
            a.btn.btn-sm.btn-link.link-dark(href=link.url, hreflang=link.lang, lang=link.lang, aria-current=locale === link.lang ? 'true' : null)= link.lang.toUpperCase()
